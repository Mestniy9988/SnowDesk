# Example only. Not installed as a GitHub workflow.
# Copy to .github/workflows/build.yml if the token may push workflow files.
name: Build SnowDesk

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  publish:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "8.0.x"

      - name: Test
        run: dotnet test SnowDesk.sln -c Release --nologo

      - name: Publish win-x64
        run: >
          dotnet publish src/SnowDesk/SnowDesk.csproj
          -c Release -r win-x64 --self-contained true
          -p:PublishSingleFile=true
          -p:IncludeNativeLibrariesForSelfExtract=true
          -p:EnableCompressionInSingleFile=true
          -p:DebugType=none
          -p:DebugSymbols=false
          -o artifacts/publish

      - uses: actions/upload-artifact@v4
        with:
          name: SnowDesk-win-x64
          path: artifacts/publish/SnowDesk.exe
          if-no-files-found: error
